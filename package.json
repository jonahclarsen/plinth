{
  "name": "plinth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:daemon": "./scripts/install-launch-agent.sh",
    "dev:daemon:stop": "./scripts/uninstall-launch-agent.sh",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:app": "tauri build --bundles app",
    "check": "svelte-check --tsconfig tsconfig.json",
    "test": "playwright test",
    "test:music": "node --test scripts/tests/music-playlist.test.mjs",
    "test:dev-runner": "node --test scripts/tests/dev-runner.test.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/icons.mjs",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "tauri": "tauri",
    "install:app": "pnpm build:app && ./scripts/install-app.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "svelte": "^5.55.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "sharp": "^0.35.4",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
